# GrowWealth Spring Boot Backend Environment Variables
# Copy to .env or set in your environment before running

# Active Profile: 'supabase' for cloud Supabase database, or 'dev' for local Postgres
SPRING_PROFILES_ACTIVE=supabase

# --- SUPABASE CONFIGURATION ---
# Replace with your Supabase Project Reference (found under Project Settings -> General)
SUPABASE_PROJECT_REF=your-project-ref

# Your Supabase database password (chosen when creating the project)
SUPABASE_DB_PASSWORD=your-database-password

# Supabase direct connection JDBC URL (port 5432)
SUPABASE_DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Or Supabase Transaction Pooler URL (recommended for IPv4/Serverless/Cloud deployments):
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.your-project-ref

# --- SECURITY ---
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLTI1Ni1iaXQtbG9uZy1zZWNyZXQta2V5LWZvci1ncm93d2VhbHRoLWp3dC1hdXRoIQ==

# --- SERVER ---
PORT=8080
